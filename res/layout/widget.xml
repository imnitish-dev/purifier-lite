<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:orientation="horizontal"
    android:gravity="center_vertical" android:padding="16dp">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/quality" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="PM2.5" android:textColor="#FF8C98A2" android:textSize="13sp" />
        <TextView android:id="@+id/pm" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="--" android:textColor="#FFECF0F3" android:textSize="40sp" android:fontFamily="sans-serif-light" />
        <TextView android:id="@+id/status" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Loading…" android:textColor="#FF8C98A2" android:textSize="12sp" android:maxLines="2" />
    </LinearLayout>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal">
        <TextView android:id="@+id/power" android:layout_width="84dp" android:layout_height="52dp"
            android:background="@drawable/btn_off" android:gravity="center" android:text="OFF"
            android:textColor="#FFECF0F3" android:textSize="16sp" android:textStyle="bold" />
        <TextView android:id="@+id/refresh" android:layout_width="84dp" android:layout_height="36dp"
            android:gravity="center" android:text="↻" android:textColor="#FF8C98A2" android:textSize="20sp" />
    </LinearLayout>
</LinearLayout>
